# Public URL of the store, used for Paymob callbacks and links in emails.
APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=backroom_store

# Paymob (Egypt). Find these in the Paymob dashboard under Settings / Developers.
# PAYMOB_MODE: "live" calls Paymob (test or live keys), "mock" uses a local
# simulated checkout so the full flow can be tried without keys.
PAYMOB_MODE=mock
PAYMOB_API_BASE=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated integration ids, e.g. card and mobile wallet.
PAYMOB_INTEGRATION_IDS=

# Email (optional). Order confirmations and contact form copies.
RESEND_API_KEY=
EMAIL_FROM="BackRoom Store <store@example.com>"
STORE_NOTIFY_EMAIL=
